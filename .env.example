# No credentials or network required in mock mode.
AI_PROVIDER=mock
HOST=127.0.0.1
PORT=3100

# Optional: a server-side OpenAI-compatible Chat Completions service.
# Do not put a key in the browser or commit .env.
# Model and regional endpoint must match your provider account.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# json_schema | json_object | prompt (capabilities vary by provider/model)
AI_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_MS=20000
# max_completion_tokens | max_tokens
AI_TOKEN_PARAMETER=max_completion_tokens
AI_MAX_OUTPUT_TOKENS=1400
